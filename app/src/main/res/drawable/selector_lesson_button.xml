<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_enabled="false">

        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="?cardBackgroundColor" />
            <padding android:top="12dp" android:bottom="12dp"/>
        </shape>

    </item>

<!--    <item android:state_enabled="true">-->

<!--        <shape android:shape="rectangle">-->
<!--            <corners android:radius="8dp" />-->
<!--            <stroke android:width="1dp" android:color="?attr/colorSecondary" />-->
<!--            <solid android:color="?attr/colorSurface" />-->
<!--        </shape>-->

<!--    </item>-->

    <item android:state_pressed="true">

        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="?attr/strokeColor" />
            <solid android:color="?buttonPressed" />
            <padding android:top="8dp" android:bottom="8dp"/>

        </shape>

    </item>

    <item android:state_pressed="false">

        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="?attr/strokeColor" />
            <solid android:color="?cardBackgroundColor" />
            <padding android:top="8dp" android:bottom="8dp"/>

        </shape>

    </item>


</selector>