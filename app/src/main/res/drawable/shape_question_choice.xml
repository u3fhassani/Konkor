<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">

    <item android:state_selected="true">
        <shape android:shape="rectangle">

            <solid android:color="#388E3C" />
            <stroke android:width="1dp" android:color="?strokeColor" />
            <corners android:radius="8dp" />
            <padding android:bottom="8dp" android:left="4dp" android:right="4dp" android:top="8dp" />

        </shape>
    </item>

    <item android:state_activated="false" android:state_selected="false">
        <shape android:shape="rectangle">

            <solid android:color="?attr/backgroundColor" />
            <stroke android:width="1dp" android:color="?strokeColor" />
            <corners android:radius="8dp" />
            <padding android:bottom="8dp" android:left="4dp" android:right="4dp" android:top="8dp" />

        </shape>
    </item>


    <item android:state_activated="true">

        <shape android:shape="rectangle">

            <solid android:color="?buttonPressed" />
            <stroke android:width="1dp" android:color="?attr/strokeColor" />
            <corners android:radius="8dp" />
            <padding android:bottom="8dp" android:left="4dp" android:right="4dp" android:top="8dp" />

        </shape>
    </item>

</selector>