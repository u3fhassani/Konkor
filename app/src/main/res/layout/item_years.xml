<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <ImageView
        android:layout_width="135dp"
        android:layout_height="135dp"
        android:layout_gravity="center"
        app:srcCompat="@drawable/ic_background_konkor_year" />

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/relativeLayout_itemYear"
        android:layout_width="100dp"
        android:layout_height="90dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="10dp"
        android:background="@drawable/item_year_shape_background"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/textView_item_year"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentTop="true"
            android:text="@string/year"
            android:textColor="@color/black"
            android:textSize="14sp"
            app:layout_constraintBottom_toTopOf="@+id/textView_item_year_in"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintLeft_toLeftOf="parent"
            app:layout_constraintRight_toRightOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintVertical_chainStyle="packed" />

        <TextView
            android:id="@+id/textView_item_year_in"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@+id/textViewItemYearAbroad"
            app:layout_constraintEnd_toEndOf="@+id/textView_item_year"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="@+id/textView_item_year"
            app:layout_constraintTop_toBottomOf="@+id/textView_item_year"
            tools:text="1391" />

        <TextView
            android:id="@+id/textView_item_year_newSystem"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/textViewItemYearAbroad"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="@+id/textViewItemYearAbroad"
            app:layout_constraintTop_toBottomOf="@+id/textViewItemYearAbroad"
            app:layout_constraintVertical_bias="0.0"
            tools:text="نظام جدید" />


        <TextView
            android:id="@+id/textViewItemYearAbroad"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/black"
            android:textSize="12sp"
            app:layout_constraintBottom_toTopOf="@+id/textView_item_year_newSystem"
            app:layout_constraintEnd_toEndOf="@+id/textView_item_year_in"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintStart_toStartOf="@+id/textView_item_year_in"
            app:layout_constraintTop_toBottomOf="@+id/textView_item_year_in"
            tools:text="خارج از کشور" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>



