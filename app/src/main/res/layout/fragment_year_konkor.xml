<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_margin="2dp"
        android:background="@drawable/shape_year_fragment_background"
        android:clipToPadding="false"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        tools:context=".ui.fragment.yearKonkor.YearKonkorFragment">


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView_year"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="4dp" />


    </FrameLayout>


    <ProgressBar
        android:id="@+id/progressYear"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:translationZ="5dp"
        android:visibility="gone" />


    <include
        android:id="@+id/failedConnection"
        layout="@layout/network_error_state" />

</FrameLayout>

