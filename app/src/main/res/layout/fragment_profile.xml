<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/coordinatorLayout_profile_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?backgroundColor"
    tools:context=".ui.fragment.profile.ProfileFragment">


    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?backgroundColor"
        app:layout_behavior="@string/appbar_scrolling_view_behavior">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardView_profile"
                style="@style/Widget.MaterialComponents.CardView"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="16dp"
                app:cardBackgroundColor="?cardBackgroundColor"
                app:cardCornerRadius="8dp"
                app:layout_constraintBottom_toBottomOf="@+id/profile_image"
                app:layout_constraintEnd_toStartOf="@+id/profile_image"
                app:layout_constraintHorizontal_bias="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@+id/profile_image"
                app:strokeColor="?strokeColor"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingTop="16dp"
                    android:paddingBottom="16dp">

                    <TextView
                        android:id="@+id/textView_profile_name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:text="@string/name"
                        android:textColor="?attr/colorOnSurface"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/textView_profile_name_in"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:textColor="?colorOnSurface"
                        app:layout_constraintBottom_toBottomOf="@id/textView_profile_name"
                        app:layout_constraintEnd_toStartOf="@id/textView_profile_name"
                        app:layout_constraintTop_toTopOf="@id/textView_profile_name"
                        tools:text="yousef" />

                    <TextView
                        android:id="@+id/textView_profile_family"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/family"
                        android:textColor="?colorOnSurface"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/textView_profile_name"
                        app:layout_constraintTop_toBottomOf="@+id/textView_profile_name" />

                    <TextView
                        android:id="@+id/textView_profile_family_in"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="8dp"
                        android:textColor="?colorOnSurface"
                        app:layout_constraintBottom_toBottomOf="@+id/textView_profile_family"
                        app:layout_constraintEnd_toStartOf="@+id/textView_profile_family"
                        app:layout_constraintTop_toTopOf="@+id/textView_profile_family"
                        tools:text="hassani" />

                </androidx.constraintlayout.widget.ConstraintLayout>


            </com.google.android.material.card.MaterialCardView>


            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/profile_image"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="8dp"
                app:civ_border_color="?attr/strokeColor"
                app:civ_border_width="2dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                tools:src="@drawable/ic_languages" />

            <TextView
                android:id="@+id/textView_profile_info"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/information"
                app:layout_constraintEnd_toEndOf="@+id/materialCardView_profile"
                app:layout_constraintTop_toBottomOf="@+id/profile_image" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/materialCardView_profile"
                style="@style/Widget.MaterialComponents.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="?cardBackgroundColor"
                app:cardCornerRadius="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView_profile_info"
                app:strokeColor="?strokeColor"
                app:strokeWidth="1dp">


                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">


                    <TextView
                        android:id="@+id/textView_profile_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginEnd="16dp"
                        android:text="@string/createAt"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/textView_profile_category"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/category2"
                        app:layout_constraintEnd_toEndOf="@+id/textView_profile_date"
                        app:layout_constraintTop_toBottomOf="@+id/textView_profile_date" />

                    <TextView
                        android:id="@+id/textView_textView_profile_age"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/yearsOld"
                        app:layout_constraintEnd_toEndOf="@+id/textView_profile_category"
                        app:layout_constraintTop_toBottomOf="@+id/textView_profile_category" />

                    <TextView
                        android:id="@+id/textView_profile_remain"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:text="@string/remainTime"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="@+id/textView_textView_profile_age"
                        app:layout_constraintTop_toBottomOf="@+id/textView_textView_profile_age" />

                    <TextView
                        android:id="@+id/textView_profile_date_in"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintBottom_toBottomOf="@+id/textView_profile_date"
                        app:layout_constraintEnd_toStartOf="@+id/textView_profile_date"
                        app:layout_constraintHorizontal_bias="1.0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/textView_profile_date"
                        tools:text="99,12,6" />

                    <TextView
                        android:id="@+id/textView_profile_category_in"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintBottom_toBottomOf="@+id/textView_profile_category"
                        app:layout_constraintEnd_toStartOf="@+id/textView_profile_category"
                        app:layout_constraintHorizontal_bias="1.0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/textView_profile_category"
                        tools:text="@string/ensani" />

                    <TextView
                        android:id="@+id/textView_profile_age_in"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintBottom_toBottomOf="@+id/textView_textView_profile_age"
                        app:layout_constraintEnd_toStartOf="@+id/textView_textView_profile_age"
                        app:layout_constraintHorizontal_bias="1.0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/textView_textView_profile_age" />

                    <TextView
                        android:id="@+id/textView_profile_remain_in"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        app:layout_constraintBottom_toBottomOf="@+id/textView_profile_remain"
                        app:layout_constraintEnd_toStartOf="@+id/textView_profile_remain"
                        app:layout_constraintHorizontal_bias="1.0"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="@+id/textView_profile_remain"
                        tools:text="365 روز" />


                </androidx.constraintlayout.widget.ConstraintLayout>


            </com.google.android.material.card.MaterialCardView>


            <TextView
                android:id="@+id/textView_profile_target"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/hadafGhozari"
                android:textColor="?attr/colorOnSurface"
                app:layout_constraintEnd_toEndOf="@id/materialCardView_profile"
                app:layout_constraintTop_toBottomOf="@+id/materialCardView_profile" />


            <com.google.android.material.card.MaterialCardView
                android:id="@+id/materialCardView_profile_listTarget"
                style="@style/Widget.MaterialComponents.CardView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="8dp"
                app:cardBackgroundColor="?cardBackgroundColor"
                app:cardCornerRadius="8dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView_profile_target"
                app:strokeColor="?strokeColor"
                app:strokeWidth="1dp">


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView_profile_target"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:padding="4dp" />


            </com.google.android.material.card.MaterialCardView>


        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/button_profile_addTarget"
        style="@style/Widget.Design.FloatingActionButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="8dp"
        android:backgroundTint="?attr/colorSecondary"
        android:textColor="?attr/colorOnSurface"
        app:elevation="4dp"
        app:fabSize="mini"
        app:layout_constraintEnd_toStartOf="@+id/textView_profile_target"
        app:layout_constraintTop_toBottomOf="@+id/materialCardView_profile"
        app:srcCompat="@drawable/ic_baseline_add_24" />


    <ProgressBar
        android:id="@+id/progress_profile_loading"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />


</androidx.coordinatorlayout.widget.CoordinatorLayout>


