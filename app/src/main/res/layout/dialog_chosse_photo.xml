<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:background="@drawable/shape_dialog_lesson"
    android:layoutDirection="ltr"
    android:layout_height="wrap_content">


    <ImageView
        android:id="@+id/imageView_dialogPhoto_camera"
        android:layout_width="54dp"
        android:layout_height="54dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@+id/imageView_dialogPhoto_gallery"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.4"
        app:srcCompat="@drawable/ic_camera" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="8dp"
        android:text="دوربین"
        android:textColor="?colorOnSurface"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="@+id/imageView_dialogPhoto_camera"
        app:layout_constraintStart_toStartOf="@+id/imageView_dialogPhoto_camera"
        app:layout_constraintTop_toBottomOf="@+id/imageView_dialogPhoto_camera" />

    <ImageView
        android:id="@+id/imageView_dialogPhoto_gallery"
        android:layout_width="54dp"
        android:layout_height="54dp"
        app:layout_constraintBottom_toBottomOf="@+id/imageView_dialogPhoto_camera"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toEndOf="@+id/imageView_dialogPhoto_camera"
        app:layout_constraintTop_toTopOf="@+id/imageView_dialogPhoto_camera"
        app:srcCompat="@drawable/ic_gallery" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="گالری"
        android:textColor="?colorOnSurface"
        android:textSize="18sp"
        app:layout_constraintEnd_toEndOf="@+id/imageView_dialogPhoto_gallery"
        app:layout_constraintStart_toStartOf="@+id/imageView_dialogPhoto_gallery"
        app:layout_constraintTop_toBottomOf="@+id/imageView_dialogPhoto_gallery" />

</androidx.constraintlayout.widget.ConstraintLayout>